{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "app-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd app && flutter run -d web-server --web-port 8080 --web-hostname localhost"
      ],
      "port": 8080
    }
  ]
}